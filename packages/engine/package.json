{
  "name": "@nonet/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript sudoku engine: generator, human-style solver, difficulty rater and play rules. No DOM, no runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate": "tsx scripts/calibrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
